<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lotustab"
        Arguments=""
        InstallLocation="C:\Program Files\LotusTab\LotusTab">
    </Installer>
    <PackageInformation
        PackageName="LotusTab"
        PackageDisplayName="LotusTab"
        PublisherName="CN=LotusTab"
        PublisherDisplayName="LotusTab"
        Version="0.1.0.0"
        PackageDescription="Desktop database client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lotustab.app"
                Description="Desktop database client"
                DisplayName="LotusTab"
                ExecutableName="lotustab"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LotusTab</DisplayName>
            <PublisherDisplayName>LotusTab</PublisherDisplayName>
            <Description>Desktop database client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lotustab.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
